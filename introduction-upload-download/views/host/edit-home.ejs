<%-include('../partials/head') %>
<body>
<%- include('../partials/nav') %>


<header class="bg-white shadow-md py-6 mb-10">
  <h1 class="text-2xl font-bold text-center text-red-700">
    <%=editing ? "Edit" : "Register"%> your home here:
  </h1>
</header>

<main class="max-w-md mx-auto px-4">

    <form action="<%= editing ? '/host/edit-home' : '/host/add-home' %>" method="POST" enctype="multipart/form-data" class="bg-white rounded-xl shadow-md p-6 flex flex-col gap-4">

<input type="hidden"
 name="_id" 
 value="<%= editing ? home._id : '' %>">

    <input
      type="text"
      name="houseName"
      value="<%= editing ? home.houseName : '' %>"
      placeholder="Enter your house name"
      class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400"
    />
    <input
      type="text"
      name="price"
            value="<%= editing ? home.price : '' %>"

      placeholder="Prices"
      class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400"
    />
    <input
      type="text"
      name="location"
                  value="<%= editing ? home.location : '' %>"

      placeholder="Location"
      class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400"
    />

    <input
      type="text"
      name="rating"
                  value="<%= editing ? home.rating : '' %>"

      placeholder="Rating"
      class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400"
    />

  <input
  type="file"
  name="photo"
  accept="image/*"
  class="block w-full text-sm text-gray-600 border border-gray-300 rounded-lg cursor-pointer
         focus:outline-none focus:ring-2 focus:ring-red-400
         file:mr-4 file:py-2 file:px-4 file:border-0 file:rounded-l-lg
         file:bg-red-500 file:text-white file:font-medium
         hover:file:bg-red-600"
/>



  <textarea
  name="description"
  placeholder="Describe about your home"
  class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400"
><%= editing ? home.description : '' %></textarea>





    <input
      type="submit"
      value="<%=editing ? 'Update': 'Register'%> Home"
      class="bg-red-700 text-white font-semibold rounded-lg py-2 cursor-pointer hover:bg-red-800 transition-colors duration-300"
    />

  </form>
</main>
</body>
</html>