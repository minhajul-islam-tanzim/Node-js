
<%- include('../partials/head') %>

<body class="bg-gray-50 min-h-screen">


<%- include('../partials/nav') %>


  <header class="bg-white shadow-md py-6 mb-8">
    <h1 class="text-3xl font-bold text-center text-gray-800">
      Here are our register Homes
    </h1>
  </header>






  <main class="max-w-6xl mx-auto px-4 py-8">
  <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
    <%
      registerHome.forEach(home => {
    %>
      <li class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300 border border-gray-100">

        <img
          src="<%= home.photoUrl %>"
          alt="<%= home.houseName %>"
          class="w-full h-44 object-cover"
        />

        <div class="p-5">
          <h2 class="text-lg font-semibold text-gray-800 mb-1">
            <%= home.houseName %>
          </h2>

          <p class="text-gray-500 text-sm mb-3">
            📍 <%= home.location %>
          </p>

          <div class="flex items-center justify-between">
            <span class="text-red-700 font-bold text-lg">
              ৳<%= home.price %>
            </span>

            <span class="flex items-center gap-1 text-sm text-gray-700 bg-amber-100 px-2 py-1 rounded-full">
              ⭐ <%= home.rating %>
            </span>
          </div>
        <button class="cursor-pointer rounded-xl bg-green-500 px-5 py-2 font-semibold text-white shadow-md shadow-rose-500/30 transition duration-200 hover:-translate-y-0.5 hover:bg-rose-600 hover:shadow-lg active:scale-95 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-rose-300 disabled:cursor-not-allowed disabled:opacity-50">Book</button>
        </div>
      </li>
    <%
      })
    %>
  </ul>
</main>
</body>
</html>