<%-include('../partials/head') %>
<body>
<%- include('../partials/nav') %>


<header class="bg-white shadow-md py-6 mb-10">
  <h1 class="text-2xl font-bold text-center text-red-700">
Login with your info
  </h1>
</header>

<main class="max-w-md mx-auto px-4">

    <form action="/auth/login" method="POST" class="bg-white rounded-xl shadow-md p-6 flex flex-col gap-4">

    <input
      type="text"
      name="username"
      placeholder="Enter your Email/username"
      class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400"
      required
    />
    <input
      type="password"
      name="password"
      value=""
      placeholder="Enter your password"
      class="border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-red-400"
      required
    />

    <input
      type="submit"
      value="Login"
      class="bg-red-700 text-white font-semibold rounded-lg py-2 cursor-pointer hover:bg-red-800 transition-colors duration-300"
    />

  </form>
</main>
</body>
</html>