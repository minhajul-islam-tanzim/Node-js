<nav class="sticky top-0 z-50 flex flex-wrap items-center gap-1.5 px-6 py-3 bg-gradient-to-r from-red-600 to-red-500 shadow-lg">

  <a href="/"
    class="<%= value === 'index' ? 'bg-white text-red-600 shadow-md' : 'text-white/90 hover:text-white hover:bg-white/20' %> px-4 py-2 rounded-full text-sm font-bold tracking-wide transition-all duration-300">
    Airbnb
  </a>
  <% if(isLoggedIn){ %>

    <a href="/home-list"
      class="<%= value === 'home-list' ? 'bg-white text-red-600 shadow-md' : 'text-white/90 hover:text-white hover:bg-white/20' %> px-4 py-2 rounded-full text-sm font-semibold tracking-wide transition-all duration-300">
      Home-List
    </a>
    <a href="/favourite-list"
      class="<%= value === 'favourite' ? 'bg-white text-red-600 shadow-md' : 'text-white/90 hover:text-white hover:bg-white/20' %> px-4 py-2 rounded-full text-sm font-semibold tracking-wide transition-all duration-300">
      Favourite
    </a>

    <a href="/bookings"
      class="<%= value === 'bookings' ? 'bg-white text-red-600 shadow-md' : 'text-white/90 hover:text-white hover:bg-white/20' %> px-4 py-2 rounded-full text-sm font-semibold tracking-wide transition-all duration-300">
      Bookings
    </a>
    <a href="/host/host-home-list"
      class="<%= value === 'host-home' ? 'bg-white text-red-600 shadow-md' : 'text-white/90 hover:text-white hover:bg-white/20' %> px-4 py-2 rounded-full text-sm font-semibold tracking-wide transition-all duration-300">
      Host-Home
    </a>

    <a href="/host/add-home"
      class="<%= value === 'add-home' ? 'bg-white text-red-600 shadow-md' : 'text-white/90 hover:text-white hover:bg-white/20' %> px-4 py-2 rounded-full text-sm font-semibold tracking-wide transition-all duration-300">
      Add Home
    </a>
  <% } %>

<% if (!isLoggedIn) { %>
  <a href="/login"
    class="ml-auto text-white/90 hover:text-white hover:bg-white/20 px-4 py-2 rounded-full text-sm font-semibold tracking-wide transition-all duration-300">
    Log in
  </a>
  <a href="/signup"
    class="bg-white text-red-600 hover:bg-red-50 hover:scale-105 shadow-md px-5 py-2 rounded-full text-sm font-bold tracking-wide transition-all duration-300">
    Sing up
  </a>
<% } else { %>
  <form action="/logout" method="POST" class="ml-auto">
    <button type="submit"
      class="cursor-pointer border border-white/50 text-white hover:bg-white hover:text-red-600 px-5 py-2 rounded-full text-sm font-semibold tracking-wide transition-all duration-300">
      Log out
    </button>
  </form>
<% } %>

</nav>