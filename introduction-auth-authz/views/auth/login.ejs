<%-include('../partials/head') %>
<body class="bg-gray-50 min-h-screen">
<%- include('../partials/nav') %>


<header class="bg-white shadow-sm border-b border-gray-100 py-8 mb-12">
  <h1 class="text-3xl font-extrabold text-center text-red-600 tracking-tight">
Login with your info
  </h1>
</header>

<main class="max-w-md mx-auto px-4 pb-16">

    <form action="/login" method="post" class="bg-white rounded-2xl shadow-xl border border-gray-100 p-8 flex flex-col gap-5">

    <input
      type="text"
      name="username"
      placeholder="Enter your Email/username"
      class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-gray-800 placeholder-gray-400 transition-all duration-300 hover:border-gray-300 focus:outline-none focus:bg-white focus:border-red-500 focus:ring-4 focus:ring-red-100"
      required
    />
    <input
      type="password"
      name="password"
      value=""
      placeholder="Enter your password"
      class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-gray-800 placeholder-gray-400 transition-all duration-300 hover:border-gray-300 focus:outline-none focus:bg-white focus:border-red-500 focus:ring-4 focus:ring-red-100"
      required
    />

    <input
      type="submit"
      value="Login"
      class="w-full bg-gradient-to-r from-red-600 to-red-500 text-white font-bold tracking-wide rounded-xl py-3 shadow-lg shadow-red-200 cursor-pointer transition-all duration-300 hover:from-red-700 hover:to-red-600 hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0"
    />

  </form>
</main>
</body>
</html>